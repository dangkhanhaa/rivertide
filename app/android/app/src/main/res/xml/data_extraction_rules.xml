<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (P2-60): nothing goes to cloud backup or to a new phone in a
     device-to-device transfer. The local database holds the device secret
     and the private fishing log (see AndroidManifest.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
